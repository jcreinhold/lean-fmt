{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lean-fmt.toml",
  "title": "lean-fmt configuration",
  "description": "Generated from the rule registry (LeanFmt/Rules.lean); do not edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "include": { "type": "array", "items": { "type": "string" } },
    "exclude": { "type": "array", "items": { "type": "string" } },
    "extend": { "type": "string" },
    "force-exclude": { "type": "boolean" },
    "respect-gitignore": { "type": "boolean" },
    "preview": { "type": "boolean" },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "line-width": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "pinned-comments": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "reflow-comments": { "type": "boolean" },
        "declaration-body": { "type": "string", "enum": ["next-line", "same-line"] },
        "declaration-where": { "type": "string", "enum": ["same-line", "next-line"] },
        "import-layout": { "type": "string", "enum": ["grouped", "canonical"] },
        "import-groups": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "magic-trailing-comma": { "type": "string", "enum": ["respect", "ignore"] }
      }
    },
    "lint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
      "select": { "type": "array", "items": { "$ref": "#/$defs/selector" } },
      "extend-select": { "type": "array", "items": { "$ref": "#/$defs/selector" } },
      "ignore": { "type": "array", "items": { "$ref": "#/$defs/selector" } },
      "fixable": { "type": "array", "items": { "$ref": "#/$defs/selector" } },
      "unfixable": { "type": "array", "items": { "$ref": "#/$defs/selector" } },
      "extend-fixable": { "type": "array", "items": { "$ref": "#/$defs/selector" } },
      "extend-safe-fixes": { "type": "array", "items": { "$ref": "#/$defs/selector" } },
      "extend-unsafe-fixes": { "type": "array", "items": { "$ref": "#/$defs/selector" } },
      "per-file-ignores": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/selector" } } }
      }
    },
    "select": { "type": "array", "items": { "$ref": "#/$defs/selector" }, "deprecated": true, "description": "moved to [lint]; still accepted, see $defs/migration" },
    "extend-select": { "type": "array", "items": { "$ref": "#/$defs/selector" }, "deprecated": true, "description": "moved to [lint]; still accepted, see $defs/migration" },
    "ignore": { "type": "array", "items": { "$ref": "#/$defs/selector" }, "deprecated": true, "description": "moved to [lint]; still accepted, see $defs/migration" },
    "fixable": { "type": "array", "items": { "$ref": "#/$defs/selector" }, "deprecated": true, "description": "moved to [lint]; still accepted, see $defs/migration" },
    "unfixable": { "type": "array", "items": { "$ref": "#/$defs/selector" }, "deprecated": true, "description": "moved to [lint]; still accepted, see $defs/migration" },
    "extend-fixable": { "type": "array", "items": { "$ref": "#/$defs/selector" }, "deprecated": true, "description": "moved to [lint]; still accepted, see $defs/migration" },
    "extend-safe-fixes": { "type": "array", "items": { "$ref": "#/$defs/selector" }, "deprecated": true, "description": "moved to [lint]; still accepted, see $defs/migration" },
    "extend-unsafe-fixes": { "type": "array", "items": { "$ref": "#/$defs/selector" }, "deprecated": true, "description": "moved to [lint]; still accepted, see $defs/migration" },
    "per-file-ignores": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/selector" } }, "deprecated": true }
  },
  "$defs": {
    "migration": {
      "description": "A linter key at the top level is the pre-[lint] spelling; it still works and emits a deprecation notice, and setting the same key in both places is an error."
    },
    "selector": {
      "description": "a live rule code, a category, a reserved code, or the words all/default",
      "enum": [
      "all",
      "default",
      "debug",
      "deprecation",
      "docs",
      "imports",
      "naming",
      "redundancy",
      "security",
      "structure",
      "unused",
      "FMT001",
      "FMT002",
      "FMT003",
      "FMT004",
      "FMT005",
      "FMT006",
      "FMT007",
      "FMT008",
      "FMT009",
      "FMT010",
      "FMT011",
      "FMT012",
      "FMT013",
      "FMT014",
      "FMT015"
      ]
    }
  }
}
